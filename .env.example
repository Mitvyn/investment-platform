# SEC requires identifying contact information in User-Agent.
SEC_USER_AGENT='Investment Research OS your-email@example.com'

# Worker-only persistence. Never expose secret key to dashboard.
IROS_OPERATOR_ID=
IROS_WORKER_ID='iros-worker-local-1'
IROS_SUPABASE_URL=
IROS_SUPABASE_SECRET_KEY=

# Worker-only LLM credentials. Never expose these to the dashboard or commit
# real values. IRO-032 offline tests do not use either key.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Worker-only candidate Massive Stocks Basic credential. Never expose through
# NEXT_PUBLIC_ or commit a real value. Adapter remains inactive until IRO-049.
MASSIVE_API_KEY=

# Optional only for legacy OpenAI keys spanning multiple orgs/projects.
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=

# Dashboard server reads with operator JWT plus publishable key.
IROS_SUPABASE_PUBLISHABLE_KEY=

# Optional worker-only Massive credential. Put real value in `.env.local`.
MASSIVE_API_KEY=
