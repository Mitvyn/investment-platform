{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-research-os.local/contracts/research-run-command.schema.json",
  "title": "Research Run Command Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "command_id",
    "operator_id",
    "security_id",
    "question_type_version",
    "workflow_config_version",
    "as_of_cutoff",
    "operator_focus_normalized",
    "idempotency_key",
    "capture_id",
    "capture_revision",
    "capture_content_hash",
    "state",
    "blocking_reason_codes",
    "error_code",
    "research_run_id",
    "created_at",
    "updated_at",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "contract_version": {
      "const": "research_run_command_receipt.v2"
    },
    "command_id": {
      "$ref": "#/$defs/uuid"
    },
    "operator_id": {
      "$ref": "#/$defs/uuid"
    },
    "security_id": {
      "$ref": "#/$defs/uuid"
    },
    "question_type_version": {
      "enum": [
        "biotech_moonshot_catalyst_assessment.v1",
        "biotech_moonshot_catalyst_personal_research_assessment.v1"
      ]
    },
    "workflow_config_version": {
      "enum": [
        "biotech-moonshot-catalyst-v1",
        "biotech-moonshot-catalyst-personal-research-v1"
      ]
    },
    "as_of_cutoff": {
      "$ref": "#/$defs/timestamp"
    },
    "operator_focus_normalized": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\s]+(?: [^\\s]+)*$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture_id": {
      "$ref": "#/$defs/uuid"
    },
    "capture_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "capture_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": ["queued", "running", "blocked", "failed", "completed"]
    },
    "blocking_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reason_code"
      }
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/reason_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "research_run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "question_type_version": {
              "const": "biotech_moonshot_catalyst_assessment.v1"
            },
            "workflow_config_version": {
              "const": "biotech-moonshot-catalyst-v1"
            }
          }
        },
        {
          "properties": {
            "question_type_version": {
              "const": "biotech_moonshot_catalyst_personal_research_assessment.v1"
            },
            "workflow_config_version": {
              "const": "biotech-moonshot-catalyst-personal-research-v1"
            }
          }
        }
      ]
    },
    {
      "oneOf": [
    {
      "properties": {
        "state": {
          "const": "queued"
        },
        "blocking_reason_codes": {
          "maxItems": 0
        },
        "error_code": {
          "type": "null"
        },
        "research_run_id": {
          "type": "null"
        },
        "started_at": {
          "type": "null"
        },
        "finished_at": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "running"
        },
        "blocking_reason_codes": {
          "maxItems": 0
        },
        "error_code": {
          "type": "null"
        },
        "research_run_id": {
          "type": "null"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "blocked"
        },
        "blocking_reason_codes": {
          "oneOf": [
            {
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                { "const": "generic_primary_source_pipeline_unavailable" },
                { "const": "persistent_committee_worker_unavailable" },
                { "const": "model_execution_inactive" },
                { "const": "licensed_valuation_unavailable" },
                { "const": "hosted_isolation_unverified" }
              ],
              "items": false
            },
            {
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                { "const": "generic_primary_source_pipeline_unavailable" },
                { "const": "persistent_committee_worker_unavailable" },
                { "const": "model_execution_inactive" },
                {
                  "const": "personal_research_valuation_pipeline_unavailable"
                },
                { "const": "hosted_isolation_unverified" }
              ],
              "items": false
            }
          ]
        },
        "error_code": {
          "type": "null"
        },
        "research_run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "null"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "failed"
        },
        "blocking_reason_codes": {
          "maxItems": 0
        },
        "error_code": {
          "$ref": "#/$defs/reason_code"
        },
        "research_run_id": {
          "type": "null"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "completed"
        },
        "blocking_reason_codes": {
          "maxItems": 0
        },
        "error_code": {
          "type": "null"
        },
        "research_run_id": {
          "$ref": "#/$defs/uuid"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
      ]
    }
  ]
}
